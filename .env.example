# MODEL=anthropic:claude-sonnet-4-5-20250929
# MODEL=openai:gpt-4o

MODEL=
MODEL_SMALL=
TEMPERATURE=0.0
# Narration backend used inside the render sandbox.
# gtts = Google Translate TTS (free, no key, needs internet; falls back to
#        pyttsx3 automatically when unreachable)
# pyttsx3 = offline espeak voice (no network)
# TTS_SERVICE=gtts
# Maximum number of QA rounds per video (code-enforced).
# MAX_QA_ROUNDS=2
# Optional model for the qa-agent. Unset = reuse MODEL (must be multimodal).
# QA_MODEL=
# Tavily web-search key for the research-agent. Unset = Wikipedia-only research.
# TAVILY_API_KEY=
# User-Agent for MediaWiki API calls. Defaults to "ConceptFlow/<version>".
# Wikimedia policy asks for a contact URL/email for higher-volume use, so set
# your own here, e.g. WIKIPEDIA_USER_AGENT=ConceptFlow/0.1 (you@example.com)
# WIKIPEDIA_USER_AGENT=
# Maximum number of research search calls per run (code-enforced).
# MAX_RESEARCH_SEARCHES=5
# Optional model for the research-agent. Unset = reuse MODEL.
# RESEARCH_MODEL=
# LLM-as-judge content moderation of the input topic and generated script.
# Enabled by default; uses MODEL_SMALL. Set to false to disable both checks.
# SAFETY_ENABLED=true
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
GOOGLE_API_KEY=

LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
